# Backend Environment Variables (.env)

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URLs
MONGODB_URL_1=mongodb+srv://...
MONGODB_URL_2=mongodb+srv://...
MONGODB_URL_3=mongodb+srv://...
MONGODB_URL_4=mongodb+srv://...
MONGODB_URL_5=mongodb+srv://...
MONGODB_URL_6=mongodb+srv://...
MONGODB_URL_7=mongodb+srv://...
MONGODB_URL_8=mongodb+srv://...

# Redis Acceleration
REDIS_URL=redis://localhost:6379

# Firebase Cloud Messaging Admin SDK (Push Notifications)
# Option A: Path to service account json file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# Option B: Inline JSON string of service account key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
